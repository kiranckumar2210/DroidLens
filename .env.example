# DroidLens — environment configuration example
# Copy to .env and fill in values for your environment.

# ── Application ──────────────────────────────────────────────────────────────
DROIDLENS_PUBLIC_URL=http://127.0.0.1:5173
DROIDLENS_LIFETIME_PRICE_INR=199
DROIDLENS_PAYMENT_PROVIDER=mock
# DROIDLENS_PAYMENT_PROVIDER=phonepe

# JWT / session (change in production!)
DROIDLENS_JWT_SECRET=change-me-in-production
DROIDLENS_LICENSE_CACHE_SECRET=change-me-in-production

# Licensing defaults (false = all authenticated users get premium)
DROIDLENS_SUBSCRIPTION_ENABLED=false

# Persistent auth DB (Railway volume mount at /data)
# DROIDLENS_AUTH_DB=/data/auth.db

# Admin bootstrap — first registration with this email gets admin role
# DROIDLENS_ADMIN_EMAIL=info.kiranc@gmail.com

# CORS (comma-separated origins, default *)
# DROIDLENS_CORS_ORIGINS=https://your-app.up.railway.app

# Production static frontend (set automatically in Docker/Railway)
# DROIDLENS_STATIC_DIR=/app/static
# DROIDLENS_HOST=0.0.0.0

# ── PhonePe Payment Gateway (Standard Checkout v2) ───────────────────────────
# Docs: https://developer.phonepe.com/payment-gateway
PHONEPE_ENVIRONMENT=sandbox
# PHONEPE_ENVIRONMENT=production

PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# User redirect after PhonePe checkout (must include payment_return handling)
PHONEPE_CALLBACK_URL=http://127.0.0.1:5173/?payment_return=1

# Webhook credentials configured in PhonePe Business Dashboard
# Authorization header = SHA256(username:password)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_SECRET=

# Optional overrides
# PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_ORDER_EXPIRE_SECONDS=1200

# ── Backend server ───────────────────────────────────────────────────────────
DROIDLENS_PORT=8765
DROIDLENS_LOG_LEVEL=INFO
